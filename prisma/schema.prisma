generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MasterResume {
  id             String   @id @default(cuid())
  name           String
  title          String
  email          String   @default("")
  phone          String   @default("")
  location       String   @default("")
  linkedin       String   @default("")
  twitter        String   @default("")
  website        String   @default("")
  summary        String   @default("")
  skills         String   @default("[]") // JSON array of strings (legacy)
  skillGroups    String   @default("[]") // JSON array of { id, category, skills[] }
  experience     String   @default("[]") // JSON array of { id, company, title, startDate, endDate, bullets[] }
  education      String   @default("[]") // JSON array of { id, school, degree, field, startDate, endDate }
  projects       String   @default("[]") // JSON array of { id, name, description, url? }
  certifications String   @default("[]") // JSON array of { id, name, issuer, date? }
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications Application[]
}

model Application {
  id                String   @id @default(cuid())
  company           String
  jobTitle          String
  jobUrl            String   @default("")
  salary            String   @default("")
  location          String   @default("")
  jobDescription    String
  extraInfo         String   @default("") // optional extra context about company/role
  status            String   @default("saved") // saved, applied, interviewing, offer, rejected
  atsScore          Int      @default(0)
  optimizedResume   String   @default("") // JSON snapshot of optimized bullets
  optimizedSummary  String   @default("")
  coverLetter       String   @default("")
  linkedinMessage   String   @default("")
  recruiterName     String   @default("")
  recruiterLinkedin String   @default("")
  notes             String   @default("")
  appliedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  generationTimes   String   @default("{}") // JSON tracking time per section

  masterResumeId  String
  masterResume    MasterResume @relation(fields: [masterResumeId], references: [id])
}

model Settings {
  id            String @id @default("default")
  ollamaModel   String @default("llama3")
  ollamaBaseUrl String @default("http://localhost:11434")
  actionConfig  String @default("{}")
}

model Scholarship {
  id           String   @id @default(cuid())
  name         String
  organization String
  track        String   @default("General") // AI, Cybersecurity, General STEM, Diversity
  url          String   @default("")
  awardAmount  String   @default("")
  deadline     String   @default("") // YYYY-MM-DD or readable deadline
  status       String   @default("saved") // saved, drafting, review, submitted, awarded
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questions    ScholarshipQuestion[]
}

model ScholarshipQuestion {
  id             String   @id @default(cuid())
  scholarshipId  String
  scholarship    Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  prompt         String
  maxWords       Int      @default(300)
  maxChars       Int      @default(0)
  answer         String   @default("")
  status         String   @default("todo") // todo, drafting, done
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StoryBankItem {
  id          String   @id @default(cuid())
  title       String
  category    String   // AI, Cybersecurity, Leadership, Challenge, Goal
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

